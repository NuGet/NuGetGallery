@model StagingGroupDetailViewModel
@{
    ViewBag.Title = Model.Name;
    ViewBag.Tab = "Packages";
    var showRenameForm = !ViewData.ModelState.IsValid;
}

<section id="staging-group" role="main" class="container main-container page-manage-packages">
    <div class="row">
        <div class="@ViewHelpers.GetColumnClasses(ViewBag)">
            <div class="breadcrumb-menu">
                <div>
                    <a class="staging-group-back-link" href="@Url.ManageMyPackages()">
                        <span aria-hidden="true" class="ms-Icon ms-Icon--ChevronLeft"></span>
                        <span>Back to Manage Packages</span>
                    </a>
                </div>
            </div>

            @if (Model.IsUngrouped)
            {
                <div class="staging-group-heading">
                    <h1>@Model.Name</h1>
                    <span class="text-muted">@Model.Description</span>
                </div>
            }
            else
            {
                <div class="staging-group-header">
                    @using (Html.BeginForm("RenameGroup", "Staging", new { owner = Model.Owner, groupId = Model.Id }, FormMethod.Post, new { @class = "form-inline staging-group-rename" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(excludePropertyErrors: true)
                        <div class="staging-group-heading">
                            <h1>
                                <span class="staging-group-name@(showRenameForm ? " hidden" : string.Empty)">@Model.Name</span>
                                @Html.Label("Name", "Display name", new { @class = "sr-only" })
                                @Html.TextBox("Name", Model.Name, new { @class = "form-control input-brand staging-group-name-input" + (showRenameForm ? string.Empty : " hidden"), maxlength = 128, required = "required", aria_label = "Display name" })
                                @if (!Model.IsPromotionActive)
                                {
                                    <button type="button"
                                            class="btn btn-brand-icon staging-group-rename-trigger@(showRenameForm ? " hidden" : string.Empty)"
                                            aria-label="Rename group"
                                            title="Rename group">
                                        <i class="ms-Icon ms-Icon--Edit" aria-hidden="true"></i>
                                    </button>
                                    <button type="submit"
                                            class="btn btn-brand-icon staging-group-rename-confirm@(showRenameForm ? string.Empty : " hidden")"
                                            aria-label="Confirm group name"
                                            title="Confirm group name">
                                        <i class="ms-Icon ms-Icon--CheckMark" aria-hidden="true"></i>
                                    </button>
                                }
                            </h1>
                            @Html.ValidationMessage("Name", new { @class = "text-danger" })
                            <span class="text-muted">@Model.Id</span>
                        </div>
                    }
                    <div class="staging-group-actions">
                        <form method="post"
                              class="staging-group-promote"
                              action="@Url.PromoteStagingGroup(Model.Owner, Model.Id)"
                              data-bind="submit: PromoteGroup">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-brand"
                                    data-bind="disable: !CanPromote || IsPromotingGroup()"
                                    disabled="disabled">
                                Promote group
                            </button>
                        </form>
                        @if (!Model.IsPromotionActive)
                        {
                            <a class="btn btn-brand-danger staging-group-delete" href="@Url.DeleteStagingGroup(Model.Owner, Model.Id)">
                                <i class="ms-Icon ms-Icon--Delete" aria-hidden="true"></i>
                                <span>Delete group</span>
                            </a>
                        }
                    </div>
                </div>
            }

            <div class="staging-group-summary">
                @if (Model.ReadyCount > 0)
                {
                    <span class="label staging-status staging-status-ready">@Model.ReadyCount ready</span>
                }
                @if (Model.ValidatingCount > 0)
                {
                    <span class="label staging-status staging-status-validating">@Model.ValidatingCount validating</span>
                }
                @if (Model.PromotingCount > 0)
                {
                    <span class="label staging-status staging-status-promoting">@Model.PromotingCount promoting</span>
                }
                @if (Model.FailedCount > 0)
                {
                    <span class="label staging-status staging-status-failedvalidation">@Model.FailedCount failed</span>
                }
            </div>
            @if (Model.IsPromotionActive)
            {
                <p class="text-muted">Promotion is in progress. You can't change this group or its packages until it's done.</p>
            }
            else if (Model.PromotionFailedCount > 0)
            {
                <p class="text-muted">Some packages failed promotion. Replace or remove them before promoting this group again.</p>
            }

            <hr class="breadcrumb-divider" />

            @if (Model.PackageCount == 0)
            {
                <p>@(Model.IsPromotionActive ? "No staged packages remain. Promotion is finishing." : "This staging group has no packages.")</p>
            }
            else
            {
                <form class="staging-group-search" role="search" data-bind="submit: Search">
                    <label class="sr-only" for="staging-group-search">Filter staged packages</label>
                    <div class="input-group">
                        <input id="staging-group-search"
                               type="search"
                               class="form-control input-brand"
                               placeholder="Filter staged packages..."
                               data-bind="textInput: SearchQuery" />
                        <span class="input-group-btn">
                            <button class="btn btn-brand" type="submit" aria-label="Filter staged packages">
                                <i class="ms-Icon ms-Icon--Search" aria-hidden="true"></i>
                            </button>
                        </span>
                    </div>
                </form>

                <p class="text-muted" aria-live="polite" data-bind="text: VisiblePackageSummary"></p>
                <p class="hidden"
                   data-bind="css: { hidden: SearchQuery().trim().length === 0 || VisiblePackageCount() !== 0 }">
                    No packages match your filter.
                </p>

                <div class="row user-package-list staging-group-package-list">
                    <div class="col-md-12">
                        <table class="table inner-table staging-packages-table">
                            <colgroup>
                                <col class="staging-package-id-column" />
                                <col class="staging-package-version-column" />
                                <col class="staging-package-status-column" />
                                <col class="staging-package-listed-column" />
                                <col class="staging-package-uploaded-column" />
                                <col class="staging-package-actions-column" />
                            </colgroup>
                            <thead>
                                <tr class="manage-package-headings">
                                    <th>Package ID</th>
                                    <th>Version</th>
                                    <th>Status</th>
                                    <th>Listed</th>
                                    <th>Staged On</th>
                                    <th><span class="sr-only">Actions</span></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: Packages">
                                <tr class="manage-package-listing"
                                    data-bind="visible: Visible, css: { 'staging-package-busy': IsBusy }, attr: { 'aria-busy': IsBusy() ? 'true' : null }">
                                    <td class="align-middle package-id" data-bind="text: Id"></td>
                                    <td class="align-middle staging-package-version" data-bind="text: Version"></td>
                                    <td class="align-middle">
                                        <div class="staging-status-content">
                                            <span class="label staging-status" data-bind="text: Status, css: StatusClass"></span>
                                            <!-- ko if: HasValidationIssues -->
                                            <button type="button"
                                                    class="btn btn-brand-transparent staging-validation-issues-toggle"
                                                    data-toggle="modal"
                                                    data-target="#staging-validation-modal"
                                                    data-bind="click: ShowValidationIssues, attr: { 'aria-label': 'View validation errors for ' + Id + ' ' + Version }"
                                                    title="View validation errors">
                                                <i class="ms-Icon ms-Icon--View" aria-hidden="true"></i>
                                            </button>
                                            <!-- /ko -->
                                        </div>
                                    </td>
                                    <td class="align-middle staging-package-listed">
                                        <form method="post"
                                              class="staging-listed-form"
                                              data-bind="attr: { action: UpdateListedUrl, 'aria-busy': IsSavingListed() ? 'true' : null }">
                                            @Html.AntiForgeryToken()
                                            <input type="checkbox"
                                                   name="listed"
                                                   value="true"
                                                   class="brand-checkbox staging-listed-input"
                                                   data-bind="checked: Listed, event: { change: UpdateListed }, disable: IsDisabled, attr: { id: ListedInputId, 'aria-label': 'List ' + Id + ' ' + Version + ' after promotion' }" />
                                            <input type="hidden" name="listed" value="false" />
                                            <span class="staging-listed-status" aria-live="polite" data-bind="text: ListedStatus"></span>
                                        </form>
                                    </td>
                                    <td class="align-middle" data-bind="text: UploadedDate"></td>
                                    <td class="text-right align-middle package-controls">
                                        <div class="dropdown staging-package-actions">
                                            <button type="button"
                                                    class="btn dropdown-toggle staging-package-actions-toggle"
                                                    data-toggle="dropdown"
                                                    aria-haspopup="true"
                                                    aria-expanded="false"
                                                    data-bind="attr: { 'aria-label': 'Actions for ' + Id + ' ' + Version }"
                                                    title="Package actions">
                                                <span aria-hidden="true">&hellip;</span>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-right">
                                                <!-- ko if: CanPromote -->
                                                <li data-bind="visible: !IsBusy()">
                                                    <a href="#"
                                                       class="staging-promote-trigger"
                                                       data-bind="click: Promote">Promote&hellip;</a>
                                                    <form method="post"
                                                          class="hidden staging-promote-form"
                                                          data-bind="attr: { action: PromoteUrl }">
                                                        @Html.AntiForgeryToken()
                                                    </form>
                                                </li>
                                                <li role="separator" class="divider" data-bind="visible: !IsBusy()"></li>
                                                <!-- /ko -->
                                                <li>
                                                    <a data-bind="attr: { href: DownloadUrl }">Download</a>
                                                </li>
                                                <!-- ko if: CanManage -->
                                                <!-- ko if: MoveUrl -->
                                                <li data-bind="visible: !IsBusy()">
                                                    <a data-bind="attr: { href: MoveUrl }">Move</a>
                                                </li>
                                                <!-- /ko -->
                                                <li data-bind="visible: !IsBusy()">
                                                    <a href="#"
                                                       class="staging-replace-trigger"
                                                       data-bind="click: ChooseReplacement">Replace&hellip;</a>
                                                    <form method="post"
                                                          enctype="multipart/form-data"
                                                          class="hidden staging-replace-form"
                                                          data-bind="attr: { action: ReplaceUrl }">
                                                        @Html.AntiForgeryToken()
                                                        <input type="file"
                                                               class="staging-replace-input"
                                                               name="packageFile"
                                                               data-bind="event: { change: Replace }"
                                                               accept=".nupkg" />
                                                    </form>
                                                </li>
                                                <li role="separator" class="divider" data-bind="visible: !IsBusy()"></li>
                                                <li data-bind="visible: !IsBusy()">
                                                    <a href="#"
                                                       class="staging-delete-trigger"
                                                       data-bind="click: Delete">Delete&hellip;</a>
                                                    <form method="post"
                                                          class="hidden staging-delete-form"
                                                          data-bind="attr: { action: DeleteUrl }">
                                                        @Html.AntiForgeryToken()
                                                    </form>
                                                </li>
                                                <!-- /ko -->
                                            </ul>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        @for (var index = 0; index < Model.Packages.Count; index++)
                        {
                            var package = Model.Packages[index];
                            if (package.ValidationIssues.Count > 0)
                            {
                                <div id="@GetStagedValidationIssuesId(index)" class="staging-validation-issues-source hidden">
                                    <ul class="validation-issues">
                                        @foreach (var issue in package.ValidationIssues)
                                        {
                                            <li>@Html.Partial("~/Views/Packages/_ValidationIssue.cshtml", issue)</li>
                                        }
                                    </ul>
                                </div>
                            }
                        }

                        <div class="modal fade staging-validation-modal"
                             id="staging-validation-modal"
                             tabindex="-1"
                             role="dialog"
                             aria-labelledby="staging-validation-modal-title">
                            <div class="modal-dialog" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <button type="button" class="close" data-dismiss="modal" aria-label="Close validation errors">
                                            <span aria-hidden="true">&times;</span>
                                        </button>
                                        <h4 class="modal-title" id="staging-validation-modal-title" tabindex="-1">Validation errors</h4>
                                    </div>
                                    <div class="modal-body">
                                        <div class="staging-validation-modal-content"></div>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="button" class="btn btn-brand-secondary" data-dismiss="modal">Close</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

@functions {
    string GetStagedValidationIssuesId(int index)
    {
        return "staged-validation-issues-" + index;
    }

    string GetStagedPackageStatus(string status)
    {
        if (status == StagedPackageStatus.FailedValidation.ToString())
        {
            return "Validation failed";
        }

        if (status == StagedPackageStatus.PromotionFailed.ToString())
        {
            return "Promotion failed";
        }

        return status;
    }

    dynamic GetSerializableStagedPackage(PackageStagingViewModel package, int index)
    {
        return new
        {
            package.Id,
            package.Version,
            Status = GetStagedPackageStatus(package.Status),
            package.StatusClass,
            UploadedDate = package.UploadedDate.ToNuGetShortDateString(),
            HasValidationIssues = package.ValidationIssues.Count > 0,
            ValidationIssuesId = GetStagedValidationIssuesId(index),
            package.CanManage,
            package.CanPromote,
            package.Listed,
            package.MoveUrl,
            ListedInputId = "staged-listed-" + index,
            DownloadUrl = Url.DownloadStagedPackage(package.Id, package.Version),
            ReplaceUrl = Url.ReplaceStagedPackage(package.Id, package.Version),
            UpdateListedUrl = Url.UpdateStagedPackageListed(package.Id, package.Version),
            PromoteUrl = Url.PromoteStagedPackage(package.Id, package.Version),
            DeleteUrl = Url.DeleteStagedPackage(package.Id, package.Version),
        };
    }
}

@section BottomScripts {
    <script nonce="@Html.GetCSPNonce()">
        window.stagingGroupData = @Html.ToJson(new
                                  {
                                      Name = Model.Name,
                                      CanPromote = Model.CanPromote,
                                      Packages = Model.Packages.Select((package, index) => GetSerializableStagedPackage(package, index)),
                                  });

        const renameTrigger = document.querySelector('.staging-group-rename-trigger');
        if (renameTrigger) {
            renameTrigger.addEventListener('click', function () {
                const name = document.querySelector('.staging-group-name');
                const input = document.querySelector('.staging-group-name-input');
                const confirm = document.querySelector('.staging-group-rename-confirm');

                name.classList.add('hidden');
                renameTrigger.classList.add('hidden');
                input.classList.remove('hidden');
                confirm.classList.remove('hidden');
                input.focus();
                input.select();
            });
        }
    </script>
    @Scripts.Render("~/Scripts/gallery/page-staging-group.min.js")
}
