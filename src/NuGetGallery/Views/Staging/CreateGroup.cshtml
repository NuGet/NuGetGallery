@model CreateStagingGroupViewModel
@{
    ViewBag.Title = "Create Staging Group";
    ViewBag.Tab = "Packages";
    ViewBag.MdPageColumns = GalleryConstants.ColumnsFormMd;
}

<section role="main" class="container main-container page-manage-packages">
    <div class="row">
        <div class="@ViewHelpers.GetColumnClasses(ViewBag)">
            <div class="breadcrumb-menu">
                <div>
                    <a class="staging-group-back-link" href="@Url.ManageMyStagingGroups()">
                        <span aria-hidden="true" class="ms-Icon ms-Icon--ChevronLeft"></span>
                        <span>Back to Staging Groups</span>
                    </a>
                </div>
            </div>

            <h1>Create Staging Group</h1>

            @using (Html.BeginForm("CreateGroup", "Staging", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-group @Html.HasErrorFor(model => model.Owner)">
                    <span class="required">@Html.ShowLabelFor(model => model.Owner)</span>
                    @Html.DropDownListFor(
                        model => model.Owner,
                        new SelectList(Model.Owners, Model.Owner),
                        new { @class = "form-control select-brand" })
                    @Html.ShowValidationMessagesFor(model => model.Owner)
                </div>

                <div class="form-group @Html.HasErrorFor(model => model.Id)">
                    <span class="required">@Html.ShowLabelFor(model => model.Id)</span>
                    @Html.ShowTextBoxFor(model => model.Id, customClass: "input-brand")
                    <span class="ms-font-s">The immutable ID used in URLs and command-line operations.</span>
                    @Html.ShowValidationMessagesFor(model => model.Id)
                </div>

                <div class="form-group @Html.HasErrorFor(model => model.Name)">
                    @Html.ShowLabelFor(model => model.Name)
                    @Html.ShowTextBoxFor(model => model.Name, customClass: "input-brand")
                    <span class="ms-font-s">Optional. Defaults to the group ID.</span>
                    @Html.ShowValidationMessagesFor(model => model.Name)
                </div>

                <div class="form-group row">
                    <div class="col-xs-6">
                        <button type="submit" class="btn btn-brand form-control">Create group</button>
                    </div>
                    <div class="col-xs-6">
                        <a class="btn btn-brand-secondary form-control" href="@Url.ManageMyStagingGroups()">Cancel</a>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
