<div id="namespace-request-guidelines">
    @ViewHelpers.AlertInfo(
        @<text>
            <div class="namespace-request-guidelines-content">
                <p><strong>Namespace reservation request limits</strong></p>
                <ul>
                    <li>You cannot submit a new request while another request is Pending.</li>
                    <li>If your request is rejected, you can try again with more information or <a href="@Url.Contact()">contact us</a>.</li>
                    <li>You can submit up to three reservation requests for the same namespace.</li>
                </ul>
            </div>
        </text>)
</div>